{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the OrcaSlicer WebConfig desktop window with tauri-plugin-fs restricted strictly to local slicer configuration directories",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$APPDATA/AnycubicSlicerNext/**" },
        { "path": "$APPDATA/OrcaSlicer/**" },
        { "path": "$CONFIG/AnycubicSlicerNext/**" },
        { "path": "$CONFIG/OrcaSlicer/**" },
        { "path": "$APPCONFIG/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$APPDATA/AnycubicSlicerNext/user/**" },
        { "path": "$APPDATA/AnycubicSlicerNext/*.conf" },
        { "path": "$APPDATA/OrcaSlicer/user/**" },
        { "path": "$APPDATA/OrcaSlicer/*.conf" },
        { "path": "$CONFIG/AnycubicSlicerNext/user/**" },
        { "path": "$CONFIG/AnycubicSlicerNext/*.conf" },
        { "path": "$CONFIG/OrcaSlicer/user/**" },
        { "path": "$CONFIG/OrcaSlicer/*.conf" },
        { "path": "$APPCONFIG/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "$APPDATA/AnycubicSlicerNext/**" },
        { "path": "$APPDATA/OrcaSlicer/**" },
        { "path": "$CONFIG/AnycubicSlicerNext/**" },
        { "path": "$CONFIG/OrcaSlicer/**" },
        { "path": "$APPCONFIG/**" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$APPDATA/AnycubicSlicerNext/**" },
        { "path": "$APPDATA/OrcaSlicer/**" },
        { "path": "$CONFIG/AnycubicSlicerNext/**" },
        { "path": "$CONFIG/OrcaSlicer/**" },
        { "path": "$APPCONFIG/**" }
      ]
    },
    {
      "identifier": "fs:deny-default"
    }
  ]
}
